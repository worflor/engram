{
  "schema": "engram-research-integration-1",
  "scope": "Original local portfolio rag_tests text sources; no corpora, weights, logs or checkpoints.",
  "method": "Content/path inventory and mechanism-level integration. Categories route review; they do not certify historical scripts.",
  "categories": {
    "host-model-audit": {
      "maintained_targets": [
        "engram_metrics.py",
        "tests/python/test_network.py"
      ],
      "disposition": "Centered variance, persistence and identity-shuffle controls integrated; transformer execution remains a consumer experiment."
    },
    "training-and-coordinates": {
      "maintained_targets": [
        "engram_training.py",
        "engram_network.py",
        "examples/train_bytes.py"
      ],
      "disposition": "Reusable streaming training, byte PMI/SVD, composition refinement, checkpoint resume, consolidation and numeric well descriptions integrated; corpus schedules and exact old runs are not library APIs."
    },
    "acceleration-and-batching": {
      "maintained_targets": [
        "engram_acceleration.py",
        "engram_training.py",
        "examples/gpu_training.py"
      ],
      "disposition": "Coalesced fitting, stable two-pass RMS, bounded ordered batches and CPU-authoritative updates integrated; historical kernel variants are research comparisons."
    },
    "core-geometry-and-replay": {
      "maintained_targets": [
        "engram_codec.py",
        "engram_analysis.py",
        "engram_wire.py",
        "engram_memory_io.py",
        "tests/python/test_reference.py",
        "tests/python/test_network.py"
      ],
      "disposition": "Shared coordinate, K/G/RMS, graph, spectrum, replay/import and numerical contracts have maintained regression coverage; exploratory conclusions are not promoted automatically."
    },
    "generation-and-feedback": {
      "maintained_targets": [
        "engram_codec.py",
        "engram_network.py",
        "examples/feedback.py",
        "examples/well_network.py"
      ],
      "disposition": "Parameter-history dreaming, per-well continuation, graph walks, lazy meta fitting and reproducible bounded feedback integrated; generation is evaluated separately from reconstruction."
    },
    "host-language-experiment": {
      "maintained_targets": [
        "engram_retrieval.py",
        "engram_embeddings.py",
        "engram_network.py"
      ],
      "disposition": "Embedding, relationship and memory interfaces integrated; local language-model prompting and semantic claims require separate host evaluation."
    }
  },
